# Backend only. Do not copy these values into VITE_* variables.
DB_NAME=forma
DB_USER=forma_app
DB_PASSWORD=replace-with-local-application-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
# Set a strong DJANGO_SECRET_KEY for deployment. Development generates an ignored .secret-key.
