# Local Django origin. In Vercel set this to your deployed Django HTTPS origin
# (no trailing /api, credentials or paths). Production builds reject localhost.
VITE_API_BASE_URL=http://localhost:8000
# Fixture/demo mode: only active if true AND (vite dev OR VITE_ENABLE_DEMO=true). Default: live API.
VITE_USE_DEV_FIXTURES=false
VITE_ENABLE_DEMO=false
# "token" (Authorization: Token <key>) or "session" (HttpOnly session cookie + CSRF)
VITE_AUTH_STRATEGY=token
